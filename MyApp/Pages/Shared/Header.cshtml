<header class="acme-header">
    <div class="acme-nav">
        <a href="/" class="acme-brand" aria-label="Acme Studio home">
            <span class="acme-mark">&#8984;</span>acme<span class="acme-brand-light">studio</span>
        </a>
        <nav aria-label="Main">
            <ul class="acme-nav-links">
                @{
                    var isAuthenticated = await Html.IsAuthenticatedAsync();
                    void RenderNavLink(string href, string childContent)
                    {
                        <li>
                            <a href="@href" class="acme-link" aria-current="@(Html.MatchesPath(href) ? "page" : null)">
                                @Html.Raw(childContent)
                            </a>
                        </li>
                    }

                    RenderNavLink("/features", "Features");
                    RenderNavLink("/pricing", "Pricing");
                    RenderNavLink("/download", "Downloads");
                    RenderNavLink("/docs", "Docs");
                    RenderNavLink("/account", "My licenses");

                    if (!isAuthenticated)
                    {
                        <li><a href="/Identity/Account/Login" class="acme-button secondary">Sign in</a></li>
                    }
                    else
                    {
                        <li>
                            <a href="/Identity/Account/Manage" class="acme-user" id="user-menu-button">
                                <img src="@User.GetPicture()" alt="">
                                <span><span class="sr-only">Open user menu for </span>@User.GetDisplayName()</span>
                            </a>
                        </li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                <button type="submit" class="acme-button secondary">Sign out</button>
                            </form>
                        </li>
                    }
                }
                <li>@await Html.PartialAsync("DarkModeToggle")</li>
            </ul>
        </nav>
    </div>
</header>
