@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<TModel>
<!doctype html>
<html lang="en" class="h-full">
@{
    var dev = HostContext.AppHost.IsDevelopmentEnvironment();
}
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg" href="/assets/img/logo.svg">
    <title>@ViewData["Title"] &middot; Acme Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/assets/css/typography.css">

    @Html.ImportMap(new()
    {
        ["vue"]                  = ("/lib/vue.mjs",                 "/lib/vue.mjs"),
        ["@servicestack/client"] = ("/lib/servicestack-client.mjs", "/lib/servicestack-client.mjs"),
        ["@servicestack/vue"]    = ("/lib/servicestack-vue.mjs",    "/lib/servicestack-vue.mjs"),
        ["app.mjs"]              = ("/mjs/app.mjs",                 "/mjs/app.mjs"),
    })
    @await RenderSectionAsync("head", required: false)
    
    @if (dev) {
        <script>window.Server = @await Html.ApiAsJsonAsync(new MetadataApp())</script>
    }
    <script type="module">
    import { useAuth, useMetadata } from "@@servicestack/vue"
    const { signIn } = useAuth()
    signIn(@await Html.ApiAsJsonAsync(new Authenticate()))
    
    const { loadMetadata } = useMetadata()
    loadMetadata({
        olderThan: window.Server ? null : location.search.includes('clear=metadata') ? 0 : 60 * 60 * 1000 //1hr 
    })
    </script>
</head>
<body>
@await Html.PartialAsync("Header")

<div class="min-h-screen">
  <main class="acme-main">
    @RenderBody()
  </main>
</div>

@await Html.PartialAsync("Footer")

<script type="module">
import { init } from "app.mjs"
init()
</script>

<script src="~/lib/jquery.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>