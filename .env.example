# Copy to .env in the repository root, then restart the backend.
# Never commit .env. Process environment variables override this file.
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
Stripe__LiveMode=false
LicenseStripe__BaseUrl=https://localhost:5001
Licensing__GitHubRepository=NetCoreApps/acme-studio
# Configure Licensing:LicensePrivateKeyPem using server secrets for license issuance.
# Bundle only the matching public key in the desktop app.
# Alternative to inline PEM: server-only file, relative to the backend content root.
# Licensing__LicensePrivateKeyPath=App_Data/license-keys/license-private.pem
# Licensing__ShortKeySalt=<base64-encoded cryptographically random 32-byte secret>

# Optional application database (defaults to SQLite).
# Supported providers: sqlite, postgres, mysql, sqlserver.
# Database__Provider=postgres
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=next_license;Username=next_license;Password=replace_me
# SQLite: ConnectionStrings__DefaultConnection=DataSource=App_Data/app.db;Cache=Shared
# See config/README.md for Kamal destinations and server-provider configuration.
